#!/usr/bin/env bash
set -euo pipefail
# Needs GEMINI_API_KEY / OPENAI_API_KEY, depending on the LLM backend
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
uvx --from graphifyy graphify extract .
python3 "$ROOT/scripts/graphify_harness_docs.py"
echo "Graphify semantic graph rebuilt (plus harness-docs overlay)"
