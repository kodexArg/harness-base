#!/usr/bin/env bash
# Rebuild the docs+harness graph into skills/kskill-graphify/graphify-out/.
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
require_cli
cd_repo
mkdir -p "$OUT_DIR"
graphify extract . --out "$SKILL_DIR"
python3 "$REPO_ROOT/scripts/graphify_harness_docs.py"
echo "graph: $GRAPH_JSON"
